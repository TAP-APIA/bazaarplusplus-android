<Project Sdk="Microsoft.NET.Sdk">
  <!-- Upstream bazaarplusplus-mod/src/BazaarPlusPlus.Storage, net6.0. -->
  <PropertyGroup>
    <AssemblyName>BazaarPlusPlus.Storage</AssemblyName>
    <RootNamespace>BazaarPlusPlus.Storage</RootNamespace>
    <BppUpstreamProject>$(BppUpstreamModSrc)BazaarPlusPlus.Storage/</BppUpstreamProject>
  </PropertyGroup>
  <ItemGroup>
    <Compile
      Include="$(BppUpstreamProject)**/*.cs"
      Exclude="$(BppUpstreamProject)bin/**;$(BppUpstreamProject)obj/**;$(BppUpstreamProject)Properties/IsExternalInitPolyfill.cs"
      Link="%(RecursiveDir)%(Filename)%(Extension)"
    />
    <None
      Include="$(BppUpstreamProject)BazaarPlusPlus.history-database.json"
      Link="BazaarPlusPlus.history-database.json"
      CopyToOutputDirectory="PreserveNewest"
    />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" />
    <PackageReference Include="SourceGear.sqlite3" />
  </ItemGroup>
</Project>
