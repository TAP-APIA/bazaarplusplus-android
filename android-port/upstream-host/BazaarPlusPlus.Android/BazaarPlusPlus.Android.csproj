<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Upstream bazaarplusplus-mod/src/BazaarPlusPlus.Android, compiled unchanged for net6.0 against
    the MelonLoader compat assembly, except for the files Overrides/ replaces (README.md).

    Input only the maintainer's machine has:
      InteropPath       the Interop Snapshot directory (upstream's `snapshot-android` output for the
                        game build the launcher runs; Il2Cpp-prefixed, the same files the launcher
                        loads at runtime)
  -->
  <PropertyGroup>
    <AssemblyName>BazaarPlusPlus.Android</AssemblyName>
    <RootNamespace>BazaarPlusPlus.Android</RootNamespace>
    <!-- AndroidGameIds.Unboxed reads a boxed IL2CPP value in place. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <BppUpstreamProject>$(BppUpstreamModSrc)BazaarPlusPlus.Android/</BppUpstreamProject>
    <BppUpstreamDesktop>$(BppUpstreamModSrc)BazaarPlusPlus/</BppUpstreamDesktop>
  </PropertyGroup>

  <!--
    Upstream files Overrides/ replaces, with the sha256 each override was written against. A
    different hash means upstream changed the file: the build warns so the override is reviewed.
  -->
  <ItemGroup>
    <BppOverriddenUpstreamFile
      Include="$(BppUpstreamProject)Lobby/AndroidVersionCheck.cs"
      ExpectedSha256="82a9abaef0c76bd99c5504daeb92f989286a3e5e3573041c6f7a3d14a6c29766"
    />
    <BppOverriddenUpstreamFile
      Include="$(BppUpstreamProject)Lobby/AndroidApkUpdatePrompt.cs"
      ExpectedSha256="a74be7ba74248dbc02cac6878f5fab30f812d7ca6511a0d80fa88112a492e1d4"
    />
  </ItemGroup>

  <ItemGroup>
    <Compile
      Include="$(BppUpstreamProject)**/*.cs"
      Exclude="$(BppUpstreamProject)bin/**;$(BppUpstreamProject)obj/**;@(BppOverriddenUpstreamFile)"
      Link="%(RecursiveDir)%(Filename)%(Extension)"
    />
    <Compile Include="Overrides/*.cs" />
  </ItemGroup>

  <!-- The melon's identity, as upstream's project file generates it. -->
  <ItemGroup>
    <AssemblyAttribute Include="MelonLoader.MelonInfoAttribute">
      <_Parameter1>typeof(BazaarPlusPlus.Android.Host.AndroidMod)</_Parameter1>
      <_Parameter1_IsLiteral>true</_Parameter1_IsLiteral>
      <_Parameter2>BazaarPlusPlus</_Parameter2>
      <_Parameter3>$(BppVersion)</_Parameter3>
      <_Parameter4>BazaarPlusPlus</_Parameter4>
    </AssemblyAttribute>
  </ItemGroup>

  <!-- Upstream's embedded resources, under the logical names upstream gives them. -->
  <ItemGroup>
    <EmbeddedResource
      Include="$(BppUpstreamDesktop)Resources/HistoryPanel/battle-result-badges.png"
      Link="Resources/HistoryPanel/battle-result-badges.png"
      LogicalName="BazaarPlusPlus.Android.Resources.HistoryPanel.battle-result-badges.png"
    />
    <EmbeddedResource
      Include="$(BppUpstreamDesktop)Resources/HistoryPanel/run-state-badges.png"
      Link="Resources/HistoryPanel/run-state-badges.png"
      LogicalName="BazaarPlusPlus.Android.Resources.HistoryPanel.run-state-badges.png"
    />
    <EmbeddedResource
      Include="$(BppUpstreamDesktop)Resources/DockButtons/collection-panel-icon.png"
      LogicalName="BazaarPlusPlus.Android.Resources.Controls.collection.png"
    />
    <EmbeddedResource
      Include="$(BppUpstreamDesktop)Resources/HistoryPanel/history-menu.png"
      LogicalName="BazaarPlusPlus.Android.Resources.Controls.history.png"
    />
    <EmbeddedResource
      Include="$(BppUpstreamDesktop)Resources/DockButtons/ten-win-builds-icon.png"
      LogicalName="BazaarPlusPlus.Android.Resources.Controls.ten-win-builds.png"
    />
    <EmbeddedResource
      Include="$(BppUpstreamDesktop)Data/BuildRecommendations/builds.json"
      Link="Data/BuildRecommendations/builds.json"
      LogicalName="BazaarPlusPlus.Data.BuildRecommendations.builds.json"
    />
    <EmbeddedResource
      Include="$(BppUpstreamDesktop)Game/Supporters/supporter-list.json"
      Link="Game/Supporters/supporter-list.json"
      LogicalName="BazaarPlusPlus.Game.Supporters.supporter-list.json"
    />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../BazaarPlusPlus.Core/BazaarPlusPlus.Core.csproj" />
    <ProjectReference Include="../MelonLoader/MelonLoader.csproj" />
    <PackageReference Include="MessagePack" />
    <PackageReference Include="Newtonsoft.Json" />
    <!-- Compile-only; the launcher's BepInEx/core supplies the runtime copies. -->
    <PackageReference Include="HarmonyX" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Il2CppInterop.Runtime" ExcludeAssets="runtime" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup Condition="'$(InteropPath)' != ''">
    <Reference Include="$(InteropPath)/*.dll" Private="false" />
  </ItemGroup>

  <Target Name="BppRequireHostInputs" BeforeTargets="ResolveAssemblyReferences">
    <Error
      Condition="'$(InteropPath)' == '' or !Exists('$(InteropPath)')"
      Text="Pass -p:InteropPath=&lt;Interop Snapshot directory&gt; (README.md, Building)."
    />
  </Target>

  <Target Name="BppCheckOverriddenUpstreamFiles" BeforeTargets="CoreCompile">
    <GetFileHash Files="@(BppOverriddenUpstreamFile)" Algorithm="SHA256" HashEncoding="hex">
      <Output TaskParameter="Items" ItemName="_BppOverriddenHash" />
    </GetFileHash>
    <Warning
      Condition="'%(_BppOverriddenHash.FileHash)' != '%(_BppOverriddenHash.ExpectedSha256)'"
      Text="Upstream changed %(_BppOverriddenHash.Identity), which Overrides/ replaces. Review the override against it, then record its new sha256 in BazaarPlusPlus.Android.csproj."
    />
  </Target>
</Project>
