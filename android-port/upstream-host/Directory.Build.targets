<Project>
  <!--
    MessagePack 3.1.4 brings System.Collections.Immutable 8.0, whose FrozenSet collides with
    Polyfills/FrozenSet.cs. Upstream calls no other Immutable API, so the 8.0 reference goes behind
    an extern alias and the polyfill binds, whichever Immutable version loads at runtime.
  -->
  <Target
    Name="BppAliasImmutable"
    AfterTargets="ResolveAssemblyReferences"
    BeforeTargets="CoreCompile"
    Condition="'$(TargetFramework)' == 'net6.0'"
  >
    <ItemGroup>
      <ReferencePath Condition="'%(Filename)' == 'System.Collections.Immutable' and '%(ReferencePath.NuGetPackageId)' == 'System.Collections.Immutable'">
        <Aliases>BppImmutable</Aliases>
      </ReferencePath>
    </ItemGroup>
  </Target>
</Project>
