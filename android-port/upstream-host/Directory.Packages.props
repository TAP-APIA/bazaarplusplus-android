<Project>
  <!-- Upstream's central pins, so the shared libraries follow the submodule. -->
  <Import Project="$(BppUpstreamRoot)bazaarplusplus-mod/Directory.Packages.props" />
  <!-- Upstream pins these only for net10.0; the same versions for net6.0. -->
  <ItemGroup Condition="'$(TargetFramework)' != 'net10.0'">
    <PackageVersion Include="MessagePack" Version="3.1.4" />
    <PackageVersion Include="Newtonsoft.Json" Version="13.0.2" />
  </ItemGroup>
  <ItemGroup>
    <!-- The launcher's BepInEx; compile-only, the launcher supplies the runtime copies. -->
    <PackageVersion Include="BepInEx.Unity.IL2CPP" Version="6.0.0-be.790" />
    <PackageVersion Include="HarmonyX" Version="2.10.2" />
  </ItemGroup>
</Project>
