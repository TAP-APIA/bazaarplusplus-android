<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <packageSources>
        <clear />
        <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
        <add key="bepinex" value="https://nuget.bepinex.dev/v3/index.json" protocolVersion="3" />
    </packageSources>
    <packageSourceMapping>
        <clear />
        <!-- MonoMod, Iced and HarmonyX resolve from either feed, so everything but the bridge
             restores where only nuget.org is reachable. BepInEx be.790 depends on the release
             Il2CppInterop 1.5.3 and Cpp2IL.Core development.1452, which only nuget.org has. -->
        <packageSource key="nuget.org">
            <package pattern="*" />
            <package pattern="MonoMod.*" />
            <package pattern="Iced" />
            <package pattern="HarmonyX" />
            <package pattern="Il2CppInterop.*" />
            <package pattern="Samboy063.Cpp2IL.Core" />
        </packageSource>
        <!-- Only the bridge plugin needs the BepInEx feed. -->
        <packageSource key="bepinex">
            <package pattern="BepInEx.*" />
            <package pattern="Samboy063.Cpp2IL.Core" />
            <package pattern="HarmonyX" />
            <package pattern="MonoMod.*" />
            <package pattern="Iced" />
            <package pattern="Il2CppInterop.*" />
        </packageSource>
    </packageSourceMapping>
</configuration>
